{
  "name": "cloudfault-storage-vitest",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudfault-storage",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "cloudfault-storage"
    }
  ]
}

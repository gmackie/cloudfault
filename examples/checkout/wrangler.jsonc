{
  "name": "cloudfault-checkout-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "kv_namespaces": [
    { "binding": "ORDER_STATE", "id": "test" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "checkout", "database_id": "test" }
  ],
  "queues": {
    "producers": [
      { "binding": "FULFILLMENT", "queue": "fulfillment" }
    ]
  }
}
